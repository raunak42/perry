{
  "name": "@perry-ai/cli",
  "version": "0.1.10",
  "description": "Terminal-native coding agent with tools, planning, MCP, skills, permissions, and subagents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raunak42/perry.git"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "perry": "dist/index.js"
  },
  "files": [
    "dist",
    "assets/startup.png",
    "assets/startup.ans",
    "assets/response-done.mp3",
    "SELF_MANIFEST.md",
    "README.md",
    "install.sh",
    "package.json"
  ],
  "scripts": {
    "test": "bun test ./test",
    "dev": "bun run ./src/index.ts",
    "dev:install": "node ./scripts/install-dev-command.cjs",
    "build": "node ./scripts/clean-dist.cjs && tsc -p tsconfig.build.json",
    "prepack": "bun x tsc --noEmit && bun test && bun run build",
    "pack:dry": "npm pack --dry-run",
    "test:terminal-ui": "bun test ./test/terminal-ui.test.ts",
    "test:formatting": "bun test ./test/terminal-formatting.test.ts",
    "test:sessions": "bun test ./test/session.test.ts",
    "test:run-command": "bun test ./test/run-command.test.ts",
    "test:image-read": "bun test ./test/image-read.test.ts",
    "test:compaction": "bun test ./test/compaction.test.ts"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "agent",
    "mcp",
    "openai"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "openai": "^6.34.0"
  }
}
